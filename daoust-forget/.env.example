# Public URL, used for canonical links, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# "preview" (default): unverified facts are shown with an "À vérifier" badge
# and the whole site is noindex. "strict": production, unverified facts hidden.
NEXT_PUBLIC_DATA_MODE=preview

# Google Analytics 4 measurement ID. Loaded only after the visitor consents.
NEXT_PUBLIC_GA_ID=
# Comma-separated ordering domains for GA4 cross-domain measurement.
NEXT_PUBLIC_GA_LINKER_DOMAINS=daoustvalet.com,myaccount.daousteco.com

# Contact form delivery (server-side only). Any HTTPS endpoint that accepts JSON.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=

# Optional address geocoding for the branch finder (server-side only).
MAPBOX_ACCESS_TOKEN=

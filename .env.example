# ---- Application ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Active le mode démo (données fictives, aucun appel QuickBooks ni envoi réel)
DEMO_MODE=true

# ---- Supabase (projet en région Canada : ca-central-1) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé serveur seulement : ne jamais préfixer par NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ---- Chiffrement des jetons QuickBooks (32 octets en base64) ----
# Générer : openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ---- QuickBooks Online (étape 2) ----
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox
QBO_REDIRECT_URI=http://localhost:3000/api/qbo/callback

# ---- Courriels (étape 4) ----
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=relances@votre-domaine.ca
RESEND_WEBHOOK_SECRET=

# ---- Tâches planifiées ----
# Secret partagé envoyé par pg_cron dans l'en-tête Authorization
CRON_SECRET=

# ---- Stripe (étape 6) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
